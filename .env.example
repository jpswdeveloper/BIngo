# ─── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_TIMEZONE=Africa/Nairobi

# ─── Database (Railway MongoDB plugin → copy the connection URL) ──
# Format: mongodb://mongo:<PASSWORD>@<HOST>:<PORT>
MONGODB_URI=

# ─── Cache (Railway Redis plugin → copy the connection URL) ───
# Format: redis://default:<PASSWORD>@<HOST>:<PORT>
REDIS_URL=

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Telebirr payment ─────────────────────────────────────────
TELEBIRR_RECEIVER_NUMBER=
TELEBIRR_RECEIVER_NAME=

# ─── Web App (your deployed frontend URL) ─────────────────────
# Must be HTTPS — used for Telegram Web App button
WEBAPP_URL=
